---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
notes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Eagerly import every image in src/assets so Astro can optimize them at build time.
// Keys look like "../assets/images/blm-0011.jpg" relative to this page.
const imageImports = import.meta.glob<ImageMetadata>(
  '../assets/images/*.{png,jpg,jpeg,webp}',
  { eager: true, import: 'default' }
);

// Resolve the card image for a note. AI-generated sketches are embedded in the
// note body by the sync function (`![AI sketch](../../assets/images/{slug}-ai.png)`).
// Prefer that on the card so the generated sketch is visible even when the note
// also has a photo; fall back to the frontmatter image otherwise.
function resolveCardImage(note: { body?: string; data: { image?: string } }) {
  const bodyImage = note.body?.match(/!\[AI sketch\]\(([^)]+)\)/)?.[1];
  const imagePath = bodyImage || note.data.image;
  if (!imagePath) return null;
  // Markdown paths are relative to src/content/notes/ ("../../assets/...") while
  // the glob keys are relative to this page ("../assets/..."). Normalize.
  const globKey = imagePath.replace(/^\.\.\/\.\.\//, '../');
  return imageImports[globKey] ?? null;
}
---

<Layout title="Field Notes — A Collection of Observations">
  <div class="container">
    <section class="hero">
      <h1>Field Notes</h1>
      <p>Observations, sketches, and records from the natural world — shared to the public.</p>
    </section>

    {notes.length > 0 ? (
      <div class="card-grid">
        {notes.map((note, index) => {
          const cardImage = resolveCardImage(note);
          return (
          <article class="note-card">
            {cardImage && (
              <Image
                src={cardImage}
                alt=""
                class="note-card-image"
                width={680}
                height={400}
                fit="cover"
                loading={index === 0 ? 'eager' : 'lazy'}
                priority={index === 0}
              />
            )}
            <div class="note-card-meta">
              <span class="date">{note.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
              <span class="separator">·</span>
              <span class="location">{note.data.location}</span>
            </div>
            <h2><a href={`/notes/${note.id}/`}>{note.data.title}</a></h2>
            <p class="excerpt">{note.data.excerpt}</p>
            {note.data.tags && note.data.tags.length > 0 && (
              <div class="tags">
                {note.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
            <a href={`/notes/${note.id}/`} class="read-more">Read field note</a>
          </article>
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon">📓</div>
        <p>No field notes yet. Check back soon.</p>
      </div>
    )}
  </div>
</Layout>