---
import '../styles/global.css';

export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title || 'Field Notes — A Collection of Observations'}</title>
    <meta name="description" content="A digital collection of field notes, observations, and sketches from the natural world." />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div>
          <a href="/" class="site-title">Field Notes</a>
          <p class="site-subtitle">A collection of observations</p>
        </div>
        <nav class="site-nav">
          <a href="/">Journal</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span class="footer-decoration">✦ ✦ ✦</span>
      <p>&copy; {new Date().getFullYear()} Field Notes. Shared to the public.</p>
    </footer>
  </body>
</html>

<style>
  /* Layout styles are in global.css */
</style>